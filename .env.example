# Spotify Credentials (Get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=<client_id>
SPOTIFY_CLIENT_SECRET=<client_secret>
SPOTIFY_REDIRECT_URI=http://localhost:8080/callback

# Apple Music Credentials
# Get media-user-token from browser DevTools on music.apple.com (Application -> Cookies/LocalStorage -> media-user-token)
APPLE_MUSIC_USER_TOKEN=<user_token>
APPLE_STOREFRONT=us

# Optional: Override Apple Developer JWT (Auto-fetched automatically if omitted)
# Get from request headers on api.music.apple.com calls in DevTools -> Network -> Authorization (without the 'Bearer ' prefix)
APPLE_DEVELOPER_JWT=<developer_jwt>
